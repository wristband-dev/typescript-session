{
  "name": "@wristband/typescript-session",
  "description": "Secure, encrypted cookie-based session management for TypeScript applications.",
  "author": "Wristband",
  "version": "1.0.0",
  "license": "MIT",
  "private": false,
  "homepage": "https://wristband.dev",
  "repository": {
    "type": "git",
    "url": "git@github.com:wristband-dev/typescript-session.git"
  },
  "bugs": {
    "email": "support@wristband.dev"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.5.1"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && rollup -c",
    "clean": "rm -rf dist",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "lint": "tsc --noEmit && eslint . --ext .js --ext .ts",
    "lint:fix": "tsc --noEmit && eslint . --ext .js --ext .ts --fix",
    "package": "npm run build && npm pack",
    "prepublishOnly": "pinst --disable",
    "postinstall": "husky install",
    "postpublish": "pinst --enable",
    "test": "jest --no-cache --runInBand",
    "test:coverage": "jest --coverage --no-cache --runInBand"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/eslint": "^8.56.12",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "pinst": "^3.0.0",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "session",
    "session-management",
    "cookie-session",
    "encrypted-cookies",
    "typescript",
    "authentication",
    "auth",
    "csrf-protection",
    "express",
    "nextjs",
    "cloudflare-workers",
    "edge-runtime",
    "serverless",
    "deno",
    "bun",
    "web-crypto",
    "framework-agnostic",
    "multi-tenant",
    "wristband"
  ]
}
